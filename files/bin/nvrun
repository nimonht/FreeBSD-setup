#!/bin/sh
# nvrun - run a program on the NVIDIA GPU (PRIME render offload).
#   nvrun glxinfo -B        nvrun vkcube        nvrun steam
# Without it, programs render on the Intel GPU that drives the laptop panel.
[ $# -gt 0 ] || { echo "usage: nvrun command [args]" >&2; exit 2; }
export __NV_PRIME_RENDER_OFFLOAD=1
export __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
export VK_DRIVER_FILES=/usr/local/share/vulkan/icd.d/nvidia_icd.json
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/local/share/glvnd/egl_vendor.d/10_nvidia.json
export LIBVA_DRIVER_NAME=nvidia
exec "$@"
