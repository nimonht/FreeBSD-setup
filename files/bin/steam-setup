#!/bin/sh
# steam-setup - one-time bootstrap of the Linux Steam client for this user,
# using games/linux-steam-utils. Run it as your normal user from a terminal
# inside the desktop session; afterwards start Steam with:  steam
set -eu
LSU=/usr/local/steam-utils/bin
[ -x "$LSU/lsu-bootstrap" ] || { echo "linux-steam-utils is not installed (run ./setup.sh gaming)" >&2; exit 1; }
[ "$(id -u)" -ne 0 ] || { echo "run this as your normal user, not root" >&2; exit 1; }

if [ ! -d "$HOME/.steam" ]; then
	echo "==> downloading and unpacking the Steam bootstrap"
	"$LSU/lsu-bootstrap"
fi

mkdir -p "$HOME/.local/bin"
cat > "$HOME/.local/bin/steam" <<'WRAP'
#!/bin/sh
# Steam on the NVIDIA GPU when the wrapper exists, otherwise on Intel.
if command -v nvrun >/dev/null 2>&1 && kldstat -q -m nvidia 2>/dev/null; then
	exec nvrun /usr/local/steam-utils/bin/steam "$@"
fi
exec /usr/local/steam-utils/bin/steam "$@"
WRAP
chmod +x "$HOME/.local/bin/steam"
echo "==> done. Start Steam with:  ~/.local/bin/steam   (add ~/.local/bin to PATH)"
echo "    In Steam: Settings > Compatibility > enable Steam Play for all titles."
