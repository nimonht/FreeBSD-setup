// Written by FreeBSD-setup: the system summary shown in a new terminal.
// Your own ~/.config/fastfetch/config.jsonc replaces this file.
// Only modules that work on FreeBSD (no power adapter, no Bluetooth).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/local/share/lumenbsd/fastfetch-logo.txt",
    "color": { "1": "yellow", "2": "red" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "Desktop" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "battery", "key": "Battery" },
    "break",
    "colors"
  ]
}
