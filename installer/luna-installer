#!/usr/bin/env python3
"""luna-installer - the LunaBSD graphical installer.

  luna-installer             install (from the live desktop's icon)
  luna-installer --welcome   "Try or Install" first (live desktop autostart)
  luna-installer --kiosk     full screen, the only program (basic graphics)
  luna-installer --demo      a made-up computer; nothing is changed

The program lives in /usr/local/share/freebsd-setup/installer (or next to
this file, in a checkout of the repository).
"""
import os
import sys

for base in (os.path.dirname(os.path.realpath(__file__)), "/usr/local/share/freebsd-setup/installer"):
    if os.path.isdir(os.path.join(base, "luna_installer")):
        sys.path.insert(0, base)
        break

from luna_installer.app import main  # noqa: E402

sys.exit(main())
