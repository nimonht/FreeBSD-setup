# Settings for setup.sh - edit before running. Plain sh syntax (KEY="value").

# The everyday (non-root) user to set the desktop up for.
# Empty = the user who ran su/doas/sudo to start setup.sh.
TARGET_USER=""

# Package branch: "latest" (newer Hyprland/Quickshell - needed by Caelestia)
# or "quarterly" (slower moving).
PKG_BRANCH="latest"

# Desktop: "hyprland" (Hyprland + Caelestia shell), "kde" (Plasma 6),
# or "both" (pick at the login screen).
DESKTOP="hyprland"

# Build and install the Caelestia shell + CLI + dotfiles (needs DESKTOP
# hyprland or both). "no" leaves you with a plain, working Hyprland.
INSTALL_CAELESTIA="yes"
# Git refs to build. "latest-tag" = newest release tag, or a branch/tag/commit.
CAELESTIA_SHELL_REF="latest-tag"
CAELESTIA_CLI_REF="latest-tag"
CAELESTIA_DOTS_REF="main"

# Graphics on this Optimus laptop (Intel HD 630 drives the panel, GTX 1050
# is the secondary GPU):
#   hybrid = Intel runs the desktop, NVIDIA is loaded for games ("nvrun <cmd>")
#   intel  = Intel only, NVIDIA driver not installed (most battery friendly,
#            and the safe fallback if hybrid misbehaves)
GPU_MODE="hybrid"
# NVIDIA driver branch. The GTX 1050 (Pascal) was dropped after 580, so this
# must stay 580 for this laptop.
NVIDIA_BRANCH="580"

# Login screen: "ly" (text UI, light), "sddm" (graphical; default for kde),
# or "none" (log in on the console and run `hypr-session`).
DISPLAY_MANAGER="ly"

# Gaming: Steam (Linux client via the Linux ABI layer), Wine/Proton, tools.
INSTALL_GAMING="yes"

# Everyday applications (browser, office, media, dev tools).
INSTALL_APPS="yes"

# ZFS: cap the ARC (file cache) so games/browsers keep their RAM. GiB.
ARC_MAX_GB="4"
# Automatic rolling snapshots (15 min / hourly / daily / weekly / monthly).
AUTO_SNAPSHOTS="yes"

# Run freebsd-update (base system security patches) during setup.
RUN_FREEBSD_UPDATE="yes"

# Wi-Fi regulatory domain (ISO country code).
WIFI_COUNTRY="VN"
